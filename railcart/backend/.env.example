MONGO_URI=mongodb://localhost:27017
DB_NAME=railcart

# Master key -- required to create/revoke API keys via /api/admin/keys.
RAILCART_MASTER_KEY=

# Comma-separated origins allowed to call the API from a browser.
RAILCART_ALLOWED_ORIGINS=http://localhost:5173

# Requests allowed per API key per minute.
RAILCART_RATE_LIMIT_PER_MINUTE=120

RAILCART_LOG_LEVEL=INFO

# Secret used to sign user login tokens (JWT). If left blank, a random
# one is generated each time the server starts -- fine for local dev,
# but every restart logs everyone out. Set a fixed random string here
# for anything beyond quick testing:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RAILCART_JWT_SECRET=

# How long a login session lasts, in minutes. 1440 = 24 hours.
RAILCART_JWT_EXPIRE_MINUTES=1440
