# For an instant test run with zero setup, use:
# MONGODB_URL=mongomock
#
# For real persistence, use a local MongoDB, Docker, or MongoDB Atlas
# connection string, e.g.:
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net
MONGODB_URL=mongomock
MONGODB_DB=rule_based_assistant

CORS_ORIGINS=*
